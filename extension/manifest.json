{
  "manifest_version": 3,
  "minimum_chrome_version": "125",
  "name": "bro",
  "description": "Lets AI agents on your computer use this browser through the local bro server. Nothing is sent off your machine.",
  "version": "2.3.0",
  "key": "",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "bro",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "storage",
    "management",
    "scripting",
    "debugger",
    "tabGroups",
    "tabs",
    "alarms",
    "webNavigation",
    "userScripts",
    "nativeMessaging"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "js": ["content/visual-indicator.js"],
      "matches": ["<all_urls>"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
